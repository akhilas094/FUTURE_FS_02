NODE_ENV=development
PORT=3000
APP_ORIGIN=http://localhost:3000
MONGODB_URI=mongodb://127.0.0.1:27017/leadflow
ADMIN_EMAIL=your-email@example.com
# npm run setup generates a bcrypt password hash and a random session secret.
ADMIN_PASSWORD_HASH=
SESSION_SECRET=
# Optional comma-separated public portfolio origins. No trailing slash.
CONTACT_ALLOWED_ORIGINS=
# Set this only to the number of trusted reverse proxies in front of the app.
TRUST_PROXY_HOPS=0
